import json
import os
import random

DATA_FILE = "quizzes.json"



def load_quizzes():
    """Load all quizzes from the JSON data file into a dictionary."""
    if not os.path.exists(DATA_FILE):
        return {}
    try:
        with open(DATA_FILE, "r") as f:
            return json.load(f)
    except (json.JSONDecodeError, IOError):
        print("Warning: quiz data file was unreadable. Starting fresh.")
        return {}


def save_quizzes(quizzes):
    """Save the full quizzes dictionary back to the JSON data file."""
    with open(DATA_FILE, "w") as f:
        json.dump(quizzes, f, indent=2)


def get_nonempty_input(prompt):
    """Keep asking until the user provides a non-empty string."""
    while True:
        value = input(prompt).strip()
        if value:
            return value
        print("This field can't be empty. Please try again.")


def get_yes_no(prompt):
    """Ask a yes/no question and return True/False."""
    while True:
        answer = input(prompt + " (y/n): ").strip().lower()
        if answer in ("y", "yes"):
            return True
        if answer in ("n", "no"):
            return False
        print("Please enter 'y' or 'n'.")


def get_choice_in_range(prompt, valid_options):
    """Ask for input until it matches one of the valid_options (case-insensitive)."""
    valid_upper = [str(v).upper() for v in valid_options]
    while True:
        choice = input(prompt).strip().upper()
        if choice in valid_upper:
            return choice
        print(f"Invalid choice. Please choose one of: {', '.join(valid_upper)}")


def create_quiz(quizzes):
    """Interactively build a new quiz and add it to the quizzes dictionary."""
    print("\n--- Create a New Quiz ---")
    title = get_nonempty_input("Enter a title for your quiz: ")

    if title in quizzes:
        if not get_yes_no(f"A quiz named '{title}' already exists. Overwrite it?"):
            print("Quiz creation cancelled.")
            return

    questions = []
    question_num = 1

    while True:
        print(f"\nQuestion {question_num}:")
        question_text = get_nonempty_input("  Enter the question: ")

        options = []
        option_letters = ["A", "B", "C", "D", "E", "F"]
        num_options = 0
        while num_options < 2:
            try:
                num_options = int(input("  How many options (2-6)? "))
            except ValueError:
                num_options = 0
            if num_options < 2 or num_options > 6:
                print("  Please enter a number between 2 and 6.")
                num_options = 0

        for i in range(num_options):
            letter = option_letters[i]
            option_text = get_nonempty_input(f"    Option {letter}: ")
            options.append(option_text)

        used_letters = option_letters[:num_options]
        correct_letter = get_choice_in_range(
            f"  Which option is correct? ({'/'.join(used_letters)}): ",
            used_letters,
        )

        questions.append({
            "question": question_text,
            "options": options,
            "correct": correct_letter,
        })

        question_num += 1
        if not get_yes_no("Add another question?"):
            break

    quizzes[title] = questions
    save_quizzes(quizzes)
    print(f"\nQuiz '{title}' created successfully with {len(questions)} question(s)!")


def choose_quiz(quizzes):
    """Let the user pick an existing quiz by number. Returns the title or None."""
    if not quizzes:
        print("\nNo quizzes available yet. Create one first!")
        return None

    titles = list(quizzes.keys())
    print("\n--- Available Quizzes ---")
    for idx, title in enumerate(titles, start=1):
        num_questions = len(quizzes[title])
        print(f"  {idx}. {title} ({num_questions} question(s))")

    while True:
        choice = input("Choose a quiz number (or 'c' to cancel): ").strip().lower()
        if choice == "c":
            return None
        if choice.isdigit() and 1 <= int(choice) <= len(titles):
            return titles[int(choice) - 1]
        print("Invalid selection. Try again.")


def take_quiz(quizzes):
    """Run a quiz attempt: ask each question, collect answers, then score it."""
    title = choose_quiz(quizzes)
    if title is None:
        return

    questions = quizzes[title]
    shuffle = get_yes_no("Shuffle question order?")
    order = list(range(len(questions)))
    if shuffle:
        random.shuffle(order)

    print(f"\n--- Starting Quiz: {title} ---")
    score = 0
    results = []  # keep per-question results to show a review at the end
    option_letters = ["A", "B", "C", "D", "E", "F"]

    for display_num, q_index in enumerate(order, start=1):
        q = questions[q_index]
        print(f"\nQ{display_num}. {q['question']}")
        letters_used = option_letters[:len(q["options"])]
        for letter, option_text in zip(letters_used, q["options"]):
            print(f"  {letter}. {option_text}")

        user_answer = get_choice_in_range("Your answer: ", letters_used)
        is_correct = user_answer == q["correct"]
        if is_correct:
            score += 1
            print("Correct!")
        else:
            correct_text = q["options"][option_letters.index(q["correct"])]
            print(f"Incorrect. The correct answer was {q['correct']}. {correct_text}")

        results.append({
            "question": q["question"],
            "your_answer": user_answer,
            "correct_answer": q["correct"],
            "is_correct": is_correct,
        })

    show_final_score(title, score, len(questions), results)


def show_final_score(title, score, total, results):
    """Display the final score, percentage, and a brief review."""
    percentage = (score / total) * 100 if total > 0 else 0

    print("\n" + "=" * 40)
    print(f"Quiz Complete: {title}")
    print(f"Score: {score}/{total} ({percentage:.1f}%)")

    if percentage == 100:
        remark = "Perfect score! Excellent work!"
    elif percentage >= 80:
        remark = "Great job!"
    elif percentage >= 50:
        remark = "Good effort, keep practicing!"
    else:
        remark = "Keep studying and try again!"
    print(remark)
    print("=" * 40)

    if get_yes_no("Would you like to review your answers?"):
        for i, r in enumerate(results, start=1):
            status = "Correct" if r["is_correct"] else "Incorrect"
            print(f"\n{i}. {r['question']}")
            print(f"   Your answer: {r['your_answer']}  |  "
                  f"Correct answer: {r['correct_answer']}  |  {status}")


def view_quizzes(quizzes):
    """Print a summary of all stored quizzes."""
    if not quizzes:
        print("\nNo quizzes have been created yet.")
        return
    print("\n--- All Quizzes ---")
    for title, questions in quizzes.items():
        print(f"  - {title}: {len(questions)} question(s)")


def delete_quiz(quizzes):
    """Let the user delete a quiz by name."""
    title = choose_quiz(quizzes)
    if title is None:
        return
    if get_yes_no(f"Are you sure you want to delete '{title}'?"):
        del quizzes[title]
        save_quizzes(quizzes)
        print(f"Quiz '{title}' deleted.")

def print_main_menu():
    print("\n" + "#" * 40)
    print("        INTERACTIVE QUIZ APP")
    print("#" * 40)
    print("1. Create a new quiz")
    print("2. Take a quiz")
    print("3. View all quizzes")
    print("4. Delete a quiz")
    print("5. Exit")


def main():
    quizzes = load_quizzes()
    print("Welcome to the Interactive Quiz Application!")

    while True:
        print_main_menu()
        choice = input("Select an option (1-5): ").strip()

        if choice == "1":
            create_quiz(quizzes)
        elif choice == "2":
            take_quiz(quizzes)
        elif choice == "3":
            view_quizzes(quizzes)
        elif choice == "4":
            delete_quiz(quizzes)
        elif choice == "5":
            print("Thanks for playing. Goodbye!")
            break
        else:
            print("Invalid option. Please select a number from 1 to 5.")


if __name__ == "__main__":
    main()
